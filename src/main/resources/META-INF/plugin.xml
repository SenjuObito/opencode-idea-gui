<idea-plugin>
    <id>com.senjuobito.opencode-buddy</id>
    <name>OpenCode Buddy</name>
    <vendor>SenjuObito</vendor>

    <!-- Resource bundle for i18n -->
    <resource-bundle>messages.OpenCodeBuddyBundle</resource-bundle>

    <description><![CDATA[
        <h2>GUI for OpenCode inside your IDE - MIT 100% Open Source</h2>
        <h2>IDE 内的 OpenCode 可视化 GUI · MIT 100% 开源</h2>
        <p>OpenCode Buddy 为 <strong>opencode</strong>（开源 AI 编程代理）提供原生 JetBrains IDE 体验：
        通过本地 <code>opencode serve</code> 服务与 <code>@opencode-ai/sdk</code> 通信，
        无需额外云端中转，配置与凭证完全由本机 opencode CLI 本地管理。</p>

        <h2>核心功能 / Features</h2>
        <ul>
            <li><strong>多标签多会话</strong>：支持多个会话标签页并发独立运行，支持标签重命名、独立浮动窗口与实时回答状态指示</li>
            <li><strong>持久化守护进程</strong>：自动启动或复用本地 <code>opencode serve</code> 常驻服务，支持心跳保活与崩溃自愈</li>
            <li><strong>完整交互界面</strong>：流式响应输出、深度思考折叠增量展示、工具调用卡片与内联代码 Diff 对比</li>
            <li><strong>原生输入感知</strong>：<code>@</code> 文件智能补全引用、图片及多模态附件拖拽/粘贴、<code>/</code> 原生斜杠命令、<code>!</code> / <code>$</code> 终端命令执行</li>
            <li><strong>Agent / 模型 / 推理配置</strong>：Build / Plan 模式切换、支持 opencode 配置的全部 Provider + Model、自定义模型添加、推理力度（Reasoning Effort）与 Always Thinking 切换</li>
            <li><strong>会话管理与导出</strong>：会话全文搜索、消息撤销重试、历史回退（Revert）、会话分支（Fork）、上下文压缩（Compact）、一键导出 Markdown 会话文档、OpenCode Share 链接分享</li>
            <li><strong>交互审批流程</strong>：文件编辑与命令执行权限审批（Once / Always / Reject）、Ask User Question 表单交互提问、Plan 计划审批</li>
            <li><strong>MCP 市场与技能</strong>：MCP 服务器状态监控、MCP 市场一键搜索/安装/卸载/配置、Skill 技能扩展管理</li>
            <li><strong>Token 用量与看板</strong>：实时 Token 消耗指示器、模型上下文窗口占用百分比、上下文分解详情与内置 TokenTracker 统计看板</li>
            <li><strong>深度 IDE 融合</strong>：明暗主题自适应跟随 IDE、IDE 编辑器与界面字体同步、状态栏小组件、中英双语界面切换</li>
        </ul>

        <h2>使用方法</h2>
        <ul>
            <li>从右侧边栏打开 <strong>OpenCode</strong> 工具窗口（需已安装 <code>opencode</code> CLI）</li>
            <li>插件会自动启动或复用本地 <code>opencode serve</code> 服务（默认端口 4096，可用 <code>OPENCODE_PORT</code> 覆盖）</li>
        </ul>

        <p><em>Keywords: OpenCode, opencode-buddy, AI Coding, Code Generation, Agent, Multi-Tab, MCP, TokenTracker</em></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF is a separate platform module in IntelliJ IDEA 2026.2+, but older
         IDEs may provide JCEF from the platform without exposing this module. -->
    <depends optional="true" config-file="jcef-features.xml">com.intellij.modules.jcef</depends>
    <!-- Optional: Terminal support for terminal output monitoring -->
    <depends optional="true" config-file="terminal-features.xml">org.jetbrains.plugins.terminal</depends>
    <!-- Optional: Java support for enhanced context collection in Java/Kotlin IDEs -->
    <depends optional="true" config-file="java-features.xml">com.intellij.java</depends>
    <!-- Optional: Python support for enhanced context collection in PyCharm/IDEA with Python plugin -->
    <depends optional="true" config-file="python-features.xml">com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- OpenCode Buddy tool window (includes history feature) -->
        <toolWindow id="OpenCode"
                    anchor="right"
                    factoryClass="com.opencodebuddy.ui.toolwindow.OpencodeBuddyToolWindow"
                    icon="/icons/opencode-icon.svg"
                    canCloseContents="true"/>

        <!-- Pre-extract AI Bridge on project open to avoid EDT freeze -->
        <postStartupActivity implementation="com.opencodebuddy.startup.BridgePreloader"/>

        <!-- Cleanup old ai-bridge cache when plugin version changes -->
        <postStartupActivity implementation="com.opencodebuddy.startup.PluginUpdateListener"/>

        <!-- Monitor Run/Debug Service Output -->
        <postStartupActivity implementation="com.opencodebuddy.service.RunConfigMonitorService"/>

        <!-- StatusBar widget for task notification -->
        <statusBarWidgetFactory id="OpencodeStatusBarWidget"
                                implementation="com.opencodebuddy.notifications.OpencodeStatusBarWidget$Factory"/>

        <!-- Notification group for DevTools and other balloon notifications -->
        <notificationGroup id="OpenCode Buddy Notifications" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Create New Tab Action -->
        <action id="OpenCodeBuddy.CreateNewTabAction"
                class="com.opencodebuddy.action.tab.CreateNewTabAction"
                icon="AllIcons.General.Add"/>
    </actions>

</idea-plugin>
