<idea-plugin>
    <!--
    Terminal-specific features for OpenCode Buddy.
    This configuration is only loaded when the Terminal plugin is available.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Monitor Terminal Output - Only active when Terminal plugin is installed -->
        <postStartupActivity implementation="com.opencodebuddy.terminal.TerminalMonitorService"/>
    </extensions>
</idea-plugin>
