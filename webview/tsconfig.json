{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    // marked-katex-extension@5.x started shipping `types: ./src/index.ts`, so
    // tsc resolves the import to the package's SOURCE and trips on its own
    // noUnusedLocals violations. The project ships an intentional ambient shim
    // in src/types/ — redirect resolution there so we type-check against our
    // contract, not the dependency's unchecked source.
    "baseUrl": ".",
    "paths": {
      "marked-katex-extension": ["./src/types/marked-katex-extension.d.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // The vendored tokentracker-dashboard tree is plain JS/JSX: resolve its
    // modules without type-checking them.
    "allowJs": true,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
